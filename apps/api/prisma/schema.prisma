// Modelo de dados do Radar360.
// Regra: identificadores (e-mail monitorado, CPF, telefone) são guardados só como HMAC-SHA256
// (chave HMAC_SECRET fora do banco) e numa versão mascarada para exibição. Nunca em texto claro.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AssetType {
  EMAIL
  CPF
  PHONE
}

enum ScanMode {
  HOME
  PUBLIC
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Tipos de incidente do copiloto. Lista fechada: o LLM só escolhe entre eles.
enum IncidentType {
  DATA_BREACH
  PIX_SCAM
  PHISHING
  ACCOUNT_TAKEOVER
  STOLEN_PHONE
  IDENTITY_FRAUD
}

enum IncidentSource {
  /// Vazamento detectado pelo monitoramento.
  DETECTED
  /// Relato do usuário ("caí num golpe do Pix").
  REPORTED
}

/// Quem definiu o tipo do incidente.
enum ClassifiedBy {
  SYSTEM
  USER
  AI
  RULES
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  assets        Asset[]
  pairingTokens PairingToken[]
  networkScans  NetworkScan[]
  sessions      Session[]
  incidents     Incident[]
}

/// Identificador que o usuário monitora. Só entra no monitoramento depois de verificado.
model Asset {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AssetType
  hmac       String
  masked     String
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  exposures Exposure[]

  /// Um identificador pertence a uma única conta (evita consultar dados de outra pessoa).
  @@unique([type, hmac])
  @@index([userId])
}

/// Incidente de vazamento. Na demo, sempre sintético; incidentes reais só como metadados.
model Breach {
  id          String    @id @default(cuid())
  slug        String    @unique
  company     String
  occurredAt  DateTime
  disclosedAt DateTime?
  /// Categorias expostas, ex.: "cpf", "telefone", "endereco", "senha_hash".
  dataClasses String[]
  description String
  sourceUrl   String?
  /// Contato público do encarregado (DPO) da empresa (LGPD, art. 41, § 1º).
  dpoContact  String?
  isSynthetic Boolean   @default(true)
  createdAt   DateTime  @default(now())

  records   BreachRecord[]
  exposures Exposure[]
  incidents Incident[]
}

/// Identificador presente num vazamento, guardado apenas como HMAC.
model BreachRecord {
  id        String    @id @default(cuid())
  breachId  String
  breach    Breach    @relation(fields: [breachId], references: [id], onDelete: Cascade)
  assetType AssetType
  hmac      String

  @@unique([breachId, assetType, hmac])
  @@index([assetType, hmac])
}

/// Ocorrência de um ativo do usuário num vazamento. O unique garante a deduplicação dos alertas.
model Exposure {
  id         String    @id @default(cuid())
  assetId    String
  asset      Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  breachId   String
  breach     Breach    @relation(fields: [breachId], references: [id], onDelete: Cascade)
  detectedAt DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([assetId, breachId])
}

/// Token que liga o agente local à conta do usuário. Guardado só como SHA-256 (token aleatório de 256 bits).
model PairingToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Sessão do site. O cookie (httpOnly) guarda o token; o banco guarda só o SHA-256 dele.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  incidents Incident[]

  @@index([userId])
  @@index([expiresAt])
}

model NetworkScan {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode         ScanMode
  agentVersion String
  hostOs       String
  startedAt    DateTime
  finishedAt   DateTime
  /// localIp, cidr, gateway, isPrivate, wifiSecurity
  network      Json
  /// Dispositivos encontrados (só no modo casa)
  devices      Json
  createdAt    DateTime @default(now())

  findings NetworkFinding[]

  @@index([userId, createdAt])
}

model NetworkFinding {
  id             String      @id @default(cuid())
  scanId         String
  scan           NetworkScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  severity       Severity
  kind           String
  title          String
  detail         String
  recommendation String
  deviceIp       String?
  port           Int?

  @@index([scanId])
}

/// Incidente acompanhado pelo copiloto. O plano não é gravado: sai dos playbooks curados a cada leitura.
model Incident {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Só na demo: cada sessão vê os próprios incidentes, que somem junto com ela.
  sessionId      String?
  session        Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type           IncidentType
  source         IncidentSource
  classifiedBy   ClassifiedBy
  breachId       String?
  breach         Breach?        @relation(fields: [breachId], references: [id], onDelete: SetNull)
  /// Relato do usuário já sem CPF, cartão, telefone e e-mail.
  narrative      String?
  /// Resumo em uma frase (IA ou texto fixo), também sem dados pessoais.
  summary        String?
  /// Sinais do relato que ativam passos extras do playbook (ex.: MONEY_SENT).
  flags          String[]       @default([])
  /// Ids dos passos do plano já concluídos.
  completedSteps String[]       @default([])
  /// Notificação LGPD ao encarregado: enviada em / respondida em.
  lgpdSentAt     DateTime?
  lgpdAnsweredAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([sessionId])
}
