# Copie para apps/api/.env e preencha. Nunca versione o .env.

# Postgres local (npm run db:up) ou gerenciado (Neon, Supabase...)
DATABASE_URL="postgresql://radar:radar@localhost:5433/radar?schema=public"

PORT=3333
# Opcional. Padrão: 127.0.0.1 em desenvolvimento e 0.0.0.0 com NODE_ENV=production.
# HOST=127.0.0.1

# Chave do HMAC dos identificadores (CPF, telefone, e-mail). Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Se trocar a chave, rode o seed de novo: os HMACs antigos deixam de bater.
HMAC_SECRET=""

# Segredo do header X-Jobs-Secret usado pelo Cloud Scheduler. Mínimo 16 caracteres.
JOBS_SECRET=""

# Origens liberadas no CORS (separadas por vírgula)
WEB_ORIGIN="http://localhost:3000"

# true = roda o job de vazamentos dentro deste processo (servidor sempre ligado).
# false = use o Cloud Scheduler chamando POST /internal/jobs/breach-check.
RUN_CRON=false
BREACH_CHECK_CRON="0 */6 * * *"

# Opcionais
# Sem a chave, o copiloto classifica os relatos por palavras-chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RESEND_API_KEY=
